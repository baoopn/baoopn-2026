# baoopn-2026 configuration. Copy to .env for local development.
# Every variable is read by internal/config (API) or web/src/env.ts (web).

# ── API ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
HTTP_ADDR=:8080
# Public site origin: email links, Clerk authorized party, sitemap.
PUBLIC_URL=http://localhost:5173
# Comma-separated origins that may read the public brand API from a browser.
# Set it empty to send no CORS headers.
BRAND_CORS_ORIGINS=https://listening.baoopn.com
DATABASE_URL=postgres://baoopn:baoopn@localhost:5433/baoopn?sslmode=disable
MIGRATE_ON_START=true
# openssl rand -hex 32 — salts visitor hashes (required in production).
SECRETS_KEY=
# Shared by web + api; lets the API trust the forwarded client IP/country.
INTERNAL_API_TOKEN=
RATE_LIMIT_PER_MINUTE=240

# ── Admin auth (Clerk) ──────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_ALLOWED_EMAILS=you@example.com
ADMIN_ALLOWED_USER_IDS=
ADMIN_ROLE=admin

# ── GitHub project sync ──────────────────────────────────────────────────────
# GitHub user whose public repos become projects (empty disables sync).
GITHUB_USER=
# Optional fine-grained token (public repos read) — raises the rate limit.
GITHUB_TOKEN=
GITHUB_SYNC_INTERVAL=6h

# ── Mail: useSend SMTP proxy ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=2587
SMTP_USER=
# useSend: the API key is the SMTP password (useSend → Settings → API keys).
SMTP_PASSWORD=
# Must be on a domain verified in useSend.
MAIL_FROM=Jane Doe <jane@mail.example.com>
# Receives new-message notifications (empty = none; editable in admin settings).
NOTIFY_EMAIL=
# Replies arrive as reply+<token>@INBOUND_MAIL_DOMAIN via the Cloudflare
# Email Worker (workers/inbound-email). Empty disables reply threading.
# e.g. reply.example.com (see docs/deployment.md).
INBOUND_MAIL_DOMAIN=
# openssl rand -hex 32 — same value as the worker's INBOUND_WEBHOOK_SECRET.
INBOUND_WEBHOOK_SECRET=
# Optional Cloudflare Turnstile for the contact form.
TURNSTILE_SECRET_KEY=

# ── Media & embeds ───────────────────────────────────────────────────────────
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=10
# S3-compatible media bucket, used only when endpoint, bucket and both keys are
# set (otherwise files stay in MEDIA_DIR). Files listed in the media table that
# are in MEDIA_DIR but not in the bucket are copied to it on startup.
# Development: the RustFS container from `make deps` (dev-only keys below; its
# console is http://localhost:9001). Production: Cloudflare R2 -
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   S3_FORCE_PATH_STYLE=false  MEDIA_PUBLIC_URL=https://media.example.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=baoopn-dev
S3_ACCESS_KEY_ID=baoopn-dev
# Local RustFS only: choose any value (e.g. `openssl rand -hex 24`). It is used
# both to start the dev container and by the API. Never a real R2 key here.
S3_SECRET_ACCESS_KEY=
# RustFS on localhost needs path-style URLs; R2 does not.
S3_FORCE_PATH_STYLE=true
# The bucket's public origin, no trailing slash. Set: media URLs point there and
# /media/<file> answers 301 to it. Empty: the API streams /media/<file> from the bucket.
MEDIA_PUBLIC_URL=

# ── Image conversion (media worker) ──────────────────────────────────────────
# Raster uploads are queued and converted to WebP by `make run-mediaworker`
# (cmd/mediaworker), which talks to the API over gRPC. Both need
# INTERNAL_API_TOKEN (above); without it the gRPC API is off and uploads fall
# back to their stripped originals after MEDIA_FALLBACK_AFTER.
# API side: gRPC listen address (private network only; :9000 is RustFS locally).
GRPC_ADDR=:9100
# Worker side: the API's gRPC address.
API_GRPC_ADDR=localhost:9100
# Both: images with more pixels are refused before decoding (413).
MEDIA_MAX_PIXELS=50000000
# Worker: longest side of the WebP (never upscaled) and its lossy quality.
MEDIA_MAX_DIMENSION=2400
MEDIA_WEBP_QUALITY=82
MEDIAWORKER_CONCURRENCY=2
MEDIAWORKER_POLL_INTERVAL=2s
# Per-job time limit; keep it below MEDIA_JOB_LEASE.
MEDIAWORKER_JOB_TIMEOUT=4m
# /healthz for `mediaworker healthcheck`.
MEDIAWORKER_HEALTH_ADDR=127.0.0.1:8081
# Coolify compose only: worker container memory cap and the Go heap target under it.
MEDIAWORKER_MEM_LIMIT=1g
MEDIAWORKER_GOMEMLIMIT=768MiB
# API: how long an upload waits for its WebP (201) before answering 202.
MEDIA_UPLOAD_WAIT=10s
# API: job lease, attempts (retries back off 5s·2^n, max 10 min), when to give
# up on the worker and publish the stripped original, and how long a failed
# upload's original is kept for POST /api/admin/media/{id}/retry.
MEDIA_JOB_LEASE=5m
MEDIA_JOB_MAX_ATTEMPTS=5
MEDIA_FALLBACK_AFTER=2m
MEDIA_FAILED_RETENTION=24h
# API: orphan cleanup (Admin > Settings > Media storage). Files no post,
# project or setting references are deleted once unused this long; 0 turns
# every deletion off (the preview still works). The daily run is off until
# turned on in the admin. At most MEDIA_ORPHAN_MAX_PER_PASS files per run.
MEDIA_ORPHAN_GRACE=168h
MEDIA_ORPHAN_MAX_PER_PASS=50

# spotify-tracker public API for the listening widgets (empty hides them).
SPOTIFY_API_URL=

# ── Web (SvelteKit) ──────────────────────────────────────────────────────────
API_URL=http://localhost:8080
PUBLIC_TURNSTILE_SITE_KEY=
# adapter-node runtime (Docker only; set by the compose files):
# ORIGIN=https://example.com  PORT=3000  BODY_SIZE_LIMIT=16M
# PROTOCOL_HEADER=x-forwarded-proto  HOST_HEADER=x-forwarded-host  ADDRESS_HEADER=x-forwarded-for

# ── Off-site backups (backup service, docs/backup.md) ─────────────────────────
# Encrypted daily pg_dump to the private R2 bucket. Never commit real values.
# The service idles with a warning until a recipient and a destination are
# set. The dev compose (profile "backup") writes to a local volume, whatever
# BACKUP_S3_* say.
# age public key (age1...) from `backupctl keygen`; several may be given,
# separated by spaces or commas. The private key never goes on the server.
BACKUP_AGE_RECIPIENT=
# S3 destination: https://<account-id>.r2.cloudflarestorage.com, the bucket
# (production: baoopn-2026-backups) and a bucket-scoped Object Read & Write token.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Defaults: auto / Cloudflare (rclone provider name, e.g. AWS, Minio, Wasabi).
BACKUP_S3_REGION=
BACKUP_S3_PROVIDER=
# Any rclone remote path instead of the S3 settings (e.g. /backups); wins
# over BACKUP_S3_* when set.
BACKUP_REMOTE=
# Object key prefix (default baoopn): <prefix>/<YYYY>/<MM>/<name>.
BACKUP_PREFIX=
# Daily run time, HH:MM in UTC (default 03:00). true = also back up at start
# (default false).
BACKUP_TIME=
BACKUP_ON_START=
# Minutes before the one retry after a failed run (default 30; 0 = no retry).
BACKUP_RETRY_MINUTES=
# Delete backups older than this many days (default 30; 0 = keep all), but
# always keep the newest BACKUP_KEEP_MIN (default 7; 0 is allowed).
BACKUP_KEEP_DAYS=
BACKUP_KEEP_MIN=
# The healthcheck turns unhealthy without a successful backup for this long
# (hours, default 26).
BACKUP_MAX_AGE_HOURS=
# Optional healthchecks.io-style URL: GET on success, <url>/fail on failure.
BACKUP_PING_URL=

# ── Tests ────────────────────────────────────────────────────────────────────
# DB tests run when set (`make pg` starts an embedded Postgres on :5434).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/postgres?sslmode=disable
# Honour CF-Connecting-IP / CF-IPCountry. They are used only when the TCP peer
# (last X-Forwarded-For entry, XFF_DEPTH=1) is a Cloudflare IP. Production: true.
TRUST_CLOUDFLARE=false
