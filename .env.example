# baoopn-2026 configuration. Copy to .env for local development.
# Every variable is read by internal/config (API) or web/src/env.ts (web).

# ── API ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
HTTP_ADDR=:8080
# Public site origin: email links, Clerk authorized party, sitemap.
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://baoopn:baoopn@localhost:5433/baoopn?sslmode=disable
MIGRATE_ON_START=true
# openssl rand -hex 32 — salts visitor hashes (required in production).
SECRETS_KEY=
# Shared by web + api; lets the API trust the forwarded client IP/country.
INTERNAL_API_TOKEN=
RATE_LIMIT_PER_MINUTE=240

# ── Admin auth (Clerk) ──────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_ALLOWED_EMAILS=you@example.com
ADMIN_ALLOWED_USER_IDS=
ADMIN_ROLE=admin

# ── GitHub project sync ──────────────────────────────────────────────────────
# GitHub user whose public repos become projects (empty disables sync).
GITHUB_USER=
# Optional fine-grained token (public repos read) — raises the rate limit.
GITHUB_TOKEN=
GITHUB_SYNC_INTERVAL=6h

# ── Mail: useSend SMTP proxy ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=2587
SMTP_USER=
# useSend: the API key is the SMTP password (useSend → Settings → API keys).
SMTP_PASSWORD=
# Must be on a domain verified in useSend.
MAIL_FROM=Jane Doe <jane@mail.example.com>
# Receives new-message notifications (empty = none; editable in admin settings).
NOTIFY_EMAIL=
# Replies arrive as reply+<token>@INBOUND_MAIL_DOMAIN via the Cloudflare
# Email Worker (workers/inbound-email). Empty disables reply threading.
# e.g. reply.example.com (see docs/deployment.md).
INBOUND_MAIL_DOMAIN=
# openssl rand -hex 32 — same value as the worker's INBOUND_WEBHOOK_SECRET.
INBOUND_WEBHOOK_SECRET=
# Optional Cloudflare Turnstile for the contact form.
TURNSTILE_SECRET_KEY=

# ── Media & embeds ───────────────────────────────────────────────────────────
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=10
# spotify-tracker public API for the listening widgets (empty hides them).
SPOTIFY_API_URL=

# ── Web (SvelteKit) ──────────────────────────────────────────────────────────
API_URL=http://localhost:8080
PUBLIC_TURNSTILE_SITE_KEY=
# adapter-node runtime (Docker only; set by the compose files):
# ORIGIN=https://example.com  PORT=3000  BODY_SIZE_LIMIT=16M
# PROTOCOL_HEADER=x-forwarded-proto  HOST_HEADER=x-forwarded-host  ADDRESS_HEADER=x-forwarded-for

# ── Tests ────────────────────────────────────────────────────────────────────
# DB tests run when set (`make pg` starts an embedded Postgres on :5434).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/postgres?sslmode=disable
# Honour CF-Connecting-IP / CF-IPCountry (only when the origin admits Cloudflare IPs only).
TRUST_CLOUDFLARE=false
