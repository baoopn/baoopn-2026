#!/bin/sh
# backupctl: encrypted, off-site PostgreSQL backups for baoopn-2026.
#
#   backupctl run                 daily scheduler (BACKUP_TIME, UTC)
#   backupctl backup              one backup now
#   backupctl list                list backups, newest first
#   backupctl restore [latest|NAME] [--force] [--to-file PATH] [-i PATH|-]
#   backupctl verify  [latest|NAME] [-i PATH|-]
#   backupctl prune               apply BACKUP_KEEP_DAYS / BACKUP_KEEP_MIN
#   backupctl keygen              new age key pair (identity on stdout)
#   backupctl health              container healthcheck
#
# Configuration is env only; see docs/backup.md.
# shellcheck source-path=SCRIPTDIR
set -u

LIB_DIR=$(dirname "$0")
# shellcheck source=backupctl-common.sh
. "$LIB_DIR/backupctl-common.sh"
# shellcheck source=backupctl-backup.sh
. "$LIB_DIR/backupctl-backup.sh"
# shellcheck source=backupctl-restore.sh
. "$LIB_DIR/backupctl-restore.sh"
# shellcheck source=backupctl-status.sh
. "$LIB_DIR/backupctl-status.sh"

usage() {
	sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
}

SLEEP_PID=

# sleep_for SECONDS: interruptible by SIGTERM (docker stop).
sleep_for() {
	[ "$1" -gt 0 ] || return 0
	sleep "$1" &
	SLEEP_PID=$!
	wait "$SLEEP_PID"
	SLEEP_PID=
}

STOP_RC=0

# on_stop: SIGTERM/SIGINT. Stops a sleep or a running backup or prune (its
# own trap kills its steps and removes its temp files), marks the run as
# interrupted, then exits.
on_stop() {
	[ -z "$SLEEP_PID" ] || kill "$SLEEP_PID" 2>/dev/null
	if [ -n "$CHILD" ]; then
		info "stopping: interrupting the running job"
		kill "$CHILD" 2>/dev/null
		wait "$CHILD" 2>/dev/null
	fi
	status_stop
	info "stopping"
	exit "$STOP_RC"
}

# idle REASON: backups are off or only partly configured. Stay up and
# healthy (no crash loop) and repeat the warning once a day. REASON names
# variables, never their values. With the status tables, report the idle
# state every minute and fail run-now requests.
idle() {
	status_write idle "$1"
	last_warn=
	while :; do
		now=$(date -u +%s)
		if [ -z "$last_warn" ] || [ $((now - last_warn)) -ge 86400 ]; then
			warn "offsite backups are disabled: $1 (see docs/backup.md); idling"
			last_warn=$now
		fi
		status_reprobe
		heartbeat idle "$1"
		fail_queued "$1"
		sleep_for 60
	done
}

# next_run_epoch: next BACKUP_TIME (UTC) strictly after now.
next_run_epoch() {
	now=$(date -u +%s)
	t=$(date -u -d "$(date -u +%Y-%m-%d) $BACKUP_TIME:00" +%s) || die "cannot compute the next run time"
	[ "$t" -gt "$now" ] || t=$((t + 86400))
	printf '%s\n' "$t"
}

# set_next EPOCH: the next scheduled run. While no backup has worked yet
# and the first one is still ahead, first_due moves with it (a new time).
set_next() {
	[ "$1" != "$NEXT" ] || return 0
	had=$NEXT
	NEXT=$1
	NEXT_TIME=$BACKUP_TIME
	info "next backup at $(date -u -d "@$NEXT" +%Y-%m-%dT%H:%MZ)"
	[ -n "$had" ] && [ -z "$(status_read last_success)" ] || return 0
	fd=$(status_read first_due)
	! is_uint "$fd" || [ "$fd" -le "$(date -u +%s)" ] || status_write first_due "$NEXT"
}

# plan_next: picks up a new BACKUP_TIME (admin override) at once.
plan_next() {
	if [ -z "$NEXT" ] || [ "$BACKUP_TIME" != "$NEXT_TIME" ]; then
		set_next "$(next_run_epoch)"
	fi
}

# run_job KIND: one backup (and prune). A failed scheduled or startup run
# gets one retry after RETRY_MINUTES; any success clears a pending retry.
run_job() {
	if backup_with_status "$1" >/dev/null; then
		RETRY_AT=
		return 0
	fi
	case $1 in
	scheduled | startup)
		[ "$RETRY_MINUTES" -gt 0 ] || return 0
		info "retrying in $RETRY_MINUTES minute(s)"
		RETRY_AT=$(($(date -u +%s) + RETRY_MINUTES * 60))
		;;
	esac
}

# sleep_tick: up to 30 s, less when the next run or retry is sooner.
sleep_tick() {
	now=$(date -u +%s)
	s=30
	[ $((NEXT - now)) -ge "$s" ] || s=$((NEXT - now))
	[ -z "$RETRY_AT" ] || [ $((RETRY_AT - now)) -ge "$s" ] || s=$((RETRY_AT - now))
	[ "$s" -ge 1 ] || s=1
	sleep_for "$s"
}

# seed_last_success: the newest complete backup in the bucket counts as the
# last success, so a redeploy does not reset the healthcheck. Errors are
# ignored: the next scheduled backup sets it anyway.
seed_last_success() {
	objs=$(list_objects 2>/dev/null) || return 0
	newest=$(printf '%s\n' "$objs" | head -n 1 | cut -d';' -f1)
	[ -n "$newest" ] || return 0
	t=$(name_epoch "$newest") || return 0
	is_uint "$t" || return 0
	status_write last_success "$t"
	info "newest backup in the $STORAGE_DESC: $newest"
}

cmd_run() {
	trap on_stop TERM INT
	mkdir -p "$STATUS_DIR" 2>/dev/null
	rm -f "$STATUS_DIR/idle" "$STATUS_DIR/first_due" "$STATUS_DIR/last_success" \
		"$STATUS_DIR/paused" "$STATUS_DIR/max_age_hours"
	AGENT_STARTED=$(date -u +%s)
	NEXT=
	NEXT_TIME=
	RETRY_AT=
	QUEUE_HOLD=0
	time_env=${BACKUP_TIME:-03:00}
	env_defaults
	RETRY_MINUTES=${BACKUP_RETRY_MINUTES:-30}
	is_uint "$RETRY_MINUTES" || RETRY_MINUTES=30
	status_init
	status_interrupted

	# Nothing set at all: an install that does not use off-site backups.
	config_untouched && idle "no BACKUP_AGE_RECIPIENT and no destination are set"
	problems=$(config_problems)
	[ -z "$problems" ] || idle "$problems"
	setup_storage || idle "no usable destination"

	valid_time "$time_env" || err "BACKUP_TIME must be HH:MM (24-hour, UTC), e.g. 03:00; using 03:00"
	is_uint "${BACKUP_RETRY_MINUTES:-30}" || err "BACKUP_RETRY_MINUTES must be a whole number of minutes; using 30"
	# Problems below do not idle: the scheduler keeps running, every backup
	# fails, and the healthcheck turns unhealthy.
	(setup_db) 2>/dev/null || err "no usable database settings (DATABASE_URL or PG*); backups will fail"
	recipients=$(mktemp "${TMPDIR:-/tmp}/backupctl-rcpt.XXXXXX") && {
		if ! (write_recipients "$recipients" && check_recipients "$recipients" /dev/null) 2>/dev/null; then
			err "invalid age recipient in BACKUP_AGE_RECIPIENT or BACKUP_AGE_RECIPIENTS_FILE; backups will fail"
		fi
		rm -f "$recipients"
	}
	seed_last_success
	apply_settings

	info "scheduler: daily at $BACKUP_TIME UTC to the $STORAGE_DESC, keep ${BACKUP_KEEP_DAYS:-30} days (at least ${BACKUP_KEEP_MIN:-7})"
	plan_next
	on_start=false
	case ${BACKUP_ON_START:-false} in true | 1 | yes) on_start=true ;; esac
	if [ "$on_start" = true ] && [ "$PAUSED" != true ]; then
		status_write first_due "$(date -u +%s)"
	else
		status_write first_due "$NEXT"
	fi
	heartbeat "$(agent_state)"
	if [ "$on_start" = true ]; then
		if [ "$PAUSED" = true ]; then
			info "paused: skipping the startup backup"
		else
			info "BACKUP_ON_START: backing up now"
			run_job startup
		fi
	fi

	# One tick every 30 s: settings, heartbeat, run-now requests, schedule.
	while :; do
		status_reprobe
		apply_settings
		plan_next
		heartbeat "$(agent_state)"
		now=$(date -u +%s)
		if [ "$now" -ge "$QUEUE_HOLD" ] && queued_run; then
			run_job manual
			# A request that could not be claimed waits 10 minutes (the
			# API expires it), so a failing write never loops backups.
			[ -n "$RUN_CLAIMED" ] || QUEUE_HOLD=$((now + 600))
			continue
		fi
		if [ "$now" -ge "$NEXT" ]; then
			if [ "$PAUSED" = true ]; then
				info "paused: skipping the scheduled backup"
			else
				run_job scheduled
			fi
			set_next "$(next_run_epoch)"
			[ "$PAUSED" != true ] || [ -n "$(status_read last_success)" ] || status_write first_due "$NEXT"
			continue
		fi
		if [ -n "$RETRY_AT" ] && [ "$now" -ge "$RETRY_AT" ]; then
			RETRY_AT=
			[ "$PAUSED" = true ] || run_job retry
			continue
		fi
		sleep_tick
	done
}

# cmd_health: healthy while idle or paused, before the scheduler wrote any status,
# while waiting for the first run (plus retry and an hour of slack), or when
# the last success is recent. Unhealthy only without a recent success.
cmd_health() {
	now=$(date -u +%s)
	if [ -f "$STATUS_DIR/idle" ]; then
		echo "idle: $(status_read idle)"
		return 0
	fi
	if [ -f "$STATUS_DIR/paused" ]; then
		echo "ok: paused"
		return 0
	fi
	first_due=$(status_read first_due)
	last=$(status_read last_success)
	if [ -z "$first_due" ] && [ -z "$last" ]; then
		echo "ok: scheduler not running yet"
		return 0
	fi
	max_hours=$(status_read max_age_hours)
	is_uint "$max_hours" || max_hours=${BACKUP_MAX_AGE_HOURS:-26}
	is_uint "$max_hours" || max_hours=26
	retry=${BACKUP_RETRY_MINUTES:-30}
	is_uint "$retry" || retry=30
	if [ -n "$last" ] && [ $((now - last)) -le $((max_hours * 3600)) ]; then
		echo "ok: last backup $(((now - last) / 60)) minute(s) ago"
		return 0
	fi
	if [ -z "$last" ] && [ -n "$first_due" ] && [ "$now" -lt $((first_due + (retry + 60) * 60)) ]; then
		echo "ok: waiting for the first backup"
		return 0
	fi
	echo "unhealthy: no successful backup in the last $max_hours hours"
	return 1
}

cmd_keygen() {
	key=$(age-keygen 2>/dev/null) || die "age-keygen failed"
	pub=$(printf '%s\n' "$key" | age-keygen -y) || die "cannot derive the public key"
	printf '%s\n' "$key"
	{
		echo
		echo "The age identity (private key) was written to stdout."
		echo "Store it safely and offline (password manager): it is the ONLY way to"
		echo "decrypt your backups and it never goes on the server."
		echo
		echo "Public recipient (set this as BACKUP_AGE_RECIPIENT):"
		echo "  $pub"
	} >&2
	if [ -t 1 ]; then
		warn "stdout is a terminal: redirect it to a file, e.g. backupctl keygen > key.txt"
	fi
}

cmd=${1:-help}
[ $# -eq 0 ] || shift
case $cmd in
run) cmd_run ;;
backup)
	STOP_RC=130
	trap on_stop TERM INT
	# Own status temp files: the scheduler may run in the same container.
	STATUS_TAG=cli
	status_init
	backup_with_status cli
	;;
list) cmd_list ;;
restore) cmd_restore "$@" ;;
verify) cmd_verify "$@" ;;
prune) cmd_prune ;;
keygen) cmd_keygen ;;
health) cmd_health ;;
help | -h | --help) usage ;;
*)
	usage >&2
	die "unknown command: $cmd"
	;;
esac
